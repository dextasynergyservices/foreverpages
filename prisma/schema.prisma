// ============================================
// LIVESTREAM SYSTEM
// ============================================

model MemorialStream {
  id            String       @id @default(cuid())
  memorialId    String
  memorial      Memorial     @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  // Stream Information
  title         String
  description   String?      @db.Text
  thumbnailUrl  String?      // Preview image for scheduled streams

  // Scheduling
  scheduledFor  DateTime?
  scheduledEnd  DateTime?    // Expected duration
  reminderSent  Boolean      @default(false)
  autoStart     Boolean      @default(false) // Automatically start at scheduledFor
  autoEnd       Boolean      @default(false) // Automatically end at scheduledEnd

  // Stream Status & Lifecycle
  status        StreamStatus @default(SCHEDULED)
  startedAt     DateTime?
  endedAt       DateTime?
  actualDuration Int?        // In seconds

  // Stream Configuration
  isPublic      Boolean      @default(true)
  allowComments Boolean      @default(true)
  allowAnonymous Boolean     @default(true) // Allow guests to watch
  recordStream  Boolean      @default(true) // Automatic recording (default ON)
  streamQuality StreamQuality @default(FULL_HD)  // Default 1080p

  // Technical Details
  streamType    StreamType   @default(WEBRTC) // WEBRTC, LIVEKIT, YOUTUBE_EMBED
  streamKey     String?      @unique // For external streaming
  rtmpUrl       String?      // For OBS/external tools (future)

  // Recording Information
  recordingUrl      String?   // Cloudinary video URL
  recordingDuration Int?      // In seconds
  recordingSize     Int?      // In bytes
  recordingStatus   RecordingStatus @default(NONE)
  recordingDeleteAt DateTime? // 30 days from stream end
  recordingDeleteWarningAt DateTime? // 7 days before deletion

  // LiveKit specific (Phase 2)
  livekitRoomName   String?   @unique
  livekitRoomSid    String?
  livekitRecordingId String?

  // Metrics & Analytics
  peakViewers      Int       @default(0)
  totalViews       Int       @default(0)
  totalComments    Int       @default(0)
  averageWatchTime Int       @default(0) // In seconds
  replayViews      Int       @default(0) // Post-stream views

  // Engagement
  likeCount     Int          @default(0)
  shareCount    Int          @default(0)

  // Privacy & Access
  password      String?      // Optional password protection
  accessToken   String?      @unique // For private stream links

  // Chat Moderation
  keywordBlacklist  String[]    @default([]) // Auto-hide comments with these words
  slowModeInterval  Int         @default(0)  // Seconds between messages (0 = disabled)
  blockedViewers    String[]    @default([]) // User IDs or session IDs of banned users

  // Notifications
  notificationsSent Boolean   @default(false)
  emailsSent        Int       @default(0)
  whatsappSent      Int       @default(0)

  // Metadata
  tags          String[]     // Searchable tags
  language      String       @default("en")
  timezone      String       @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  viewers       StreamViewer[]
  comments      StreamComment[]
  reactions     StreamReaction[]
  recordings    StreamRecording[]  // Multiple recordings (clips, highlights)
  analytics     StreamAnalytics[]

  @@index([memorialId])
  @@index([status])
  @@index([scheduledFor])
  @@index([streamType])
  @@index([createdAt])
  @@index([startedAt])
  @@index([recordingDeleteAt])
}

enum StreamStatus {
  SCHEDULED    // Created but not started
  STARTING     // Initializing (broadcaster connecting)
  LIVE         // Currently streaming
  PAUSED       // Temporarily paused (future feature)
  ENDING       // Finishing up
  ENDED        // Stream completed successfully
  CANCELLED    // Cancelled before starting
  FAILED       // Technical failure
}

enum StreamType {
  WEBRTC        // Phase 1: Direct P2P
  LIVEKIT       // Phase 2: Media server
  YOUTUBE_EMBED // Phase 3: External embed
  FACEBOOK_LIVE // Phase 3: External embed
}

enum StreamQuality {
  LOWEST   // 144p
  LOW      // 240p
  MEDIUM   // 360p
  SD       // 480p
  HD       // 720p
  FULL_HD  // 1080p (default)
}

enum RecordingStatus {
  NONE         // Not recording
  RECORDING    // Currently recording
  PROCESSING   // Post-processing after stream
  READY        // Available for playback
  FAILED       // Recording failed
  DELETED      // Deleted by user
}

model StreamViewer {
  id          String         @id @default(cuid())
  streamId    String
  stream      MemorialStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  // Viewer Identity
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId   String         // Unique per browser session

  // Anonymous Viewer Info
  guestName   String?        // Self-provided name
  email       String?        // Optional email for notifications

  // Technical Details
  ipAddress   String?
  userAgent   String?        @db.Text
  deviceType  String?        // mobile, tablet, desktop
  browser     String?
  country     String?        // Geo-location
  city        String?

  // Viewing Behavior
  joinedAt    DateTime       @default(now())
  leftAt      DateTime?
  watchTime   Int            @default(0) // In seconds
  isActive    Boolean        @default(true)

  // Engagement
  commented   Boolean        @default(false)
  reacted     Boolean        @default(false)
  shared      Boolean        @default(false)

  // Connection Quality
  connectionQuality String?   // poor, fair, good, excellent
  bufferingEvents   Int       @default(0)

  // Moderation & Status
  isPinned    Boolean        @default(false) // Pinned by broadcaster (family members)
  isVIP       Boolean        @default(false) // VIP badge for special guests
  isBlocked   Boolean        @default(false) // Blocked/kicked from stream
  blockedAt   DateTime?      // When viewer was blocked
  blockedReason String?      // Reason for blocking

  @@index([streamId])
  @@index([userId])
  @@index([sessionId])
  @@index([joinedAt])
  @@index([isPinned])
  @@index([isVIP])
  @@unique([streamId, sessionId])
}

model StreamComment {
  id        String         @id @default(cuid())
  streamId  String
  stream    MemorialStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  // Author
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String        // Display name (from user or guest)
  authorEmail String?      // For guests

  // Comment Content
  content   String         @db.Text
  timestamp Int?           // Seconds from stream start (for replay)

  // Moderation
  isApproved Boolean       @default(true)
  isHidden   Boolean       @default(false)
  isReported Boolean       @default(false)
  isPinned   Boolean       @default(false)
  moderationReason String? // Reason for hide/delete (keyword match, manual, etc.)

  // Engagement
  likeCount Int            @default(0)

  createdAt DateTime       @default(now())

  @@index([streamId])
  @@index([userId])
  @@index([createdAt])
  @@index([isPinned])
}

model StreamReaction {
  id        String         @id @default(cuid())
  streamId  String
  stream    MemorialStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  // Reactor
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String         // For anonymous reactions

  // Reaction Type
  type      LivestreamReactionType
  timestamp Int?           // Seconds from stream start

  createdAt DateTime       @default(now())

  @@index([streamId])
  @@index([userId])
  @@index([sessionId])
  @@unique([streamId, sessionId, type]) // One reaction type per viewer
}

enum LivestreamReactionType {
  HEART      // ❤️
  PRAYER     // 🙏
  CANDLE     // 🕯️
  FLOWER     // 🌹
  DOVE       // 🕊️
  APPLAUSE   // 👏
}

model StreamRecording {
  id            String         @id @default(cuid())
  streamId      String
  stream        MemorialStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  // Recording Info
  title         String         @default("Full Recording")
  description   String?        @db.Text

  // File Details
  url           String         // Cloudinary URL
  duration      Int            // In seconds
  fileSize      Int            // In bytes
  format        String         @default("mp4")
  resolution    String         @default("1920x1080") // Default 1080p
  quality       StreamQuality  @default(FULL_HD)

  // Timing
  recordingType RecordingType  @default(FULL)
  startOffset   Int            @default(0) // For clips/highlights
  endOffset     Int?

  // Processing
  status        RecordingStatus @default(PROCESSING)
  processedAt   DateTime?

  // 6-month Retention
  deleteAt      DateTime?      // Auto-delete after 6 months
  deleteWarningAt DateTime?    // Warning 7 days before deletion
  deleteWarningSent Boolean    @default(false)

  // Metadata
  thumbnailUrl  String?
  subtitlesUrl  String?        // VTT/SRT file (future)

  // Stats
  views         Int            @default(0)
  downloads     Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([streamId])
  @@index([status])
  @@index([deleteAt])
}

enum RecordingType {
  FULL       // Complete stream recording
  CLIP       // User-created clip
  HIGHLIGHT  // Auto-generated highlight
}

model StreamAnalytics {
  id            String         @id @default(cuid())
  streamId      String
  stream        MemorialStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  // Time-series data point
  timestamp     DateTime       @default(now())

  // Metrics at this point
  concurrentViewers Int
  totalViewers      Int

  // Quality metrics
  averageBitrate    Int?       // kbps
  bufferRatio       Float?     // % of viewers buffering

  // Engagement at this point
  commentsCount     Int        @default(0)
  reactionsCount    Int        @default(0)

  @@index([streamId])
  @@index([timestamp])
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SiteSettings {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  type  SettingType

  description String?  @db.Text
  isPublic    Boolean  @default(false)

  updatedAt DateTime @updatedAt

  @@index([key])
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  TEXT
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      AnnouncementType

  isActive  Boolean  @default(true)
  startDate DateTime @default(now())
  endDate   DateTime?

  // Targeting
  showToAll Boolean  @default(true)
  showToGuests Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
}

enum AnnouncementType {
  INFO
  SUCCESS
  WARNING
  ERROR
  MAINTENANCE
}

enum PreviewMode {
  AUTO      // Determine automatically
  IFRAME    // Embed in iframe (legacy)
  STATIC    // Serve static HTML (legacy)
  NATIVE    // Next.js native page (new default)
}