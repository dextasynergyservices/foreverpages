model Subscription {
  id                String             @id @default(cuid())
  status            SubscriptionStatus

  // Subscription Period
  startDate        DateTime
  expiresAt        DateTime  // When the subscription expires

  // Renewal/Lifetime Access
  renewalId        String?
  renewal          Renewal?  @relation(fields: [renewalId], references: [id], onDelete: SetNull)
  renewedAt        DateTime? // When user upgraded to lifetime

  // Payment Info (Paystack)
  paystackReference String?   @unique  // Paystack transaction reference
  paystackCustomerCode String? // Paystack customer code for recurring payments

  // Subscription Management
  autoRenew        Boolean   @default(false)  // Changed to false - users must manually renew
  canceledAt       DateTime?

  // Grace Period (allows users to renew even after expiration)
  gracePeriodDays  Int       @default(7)  // 7 days grace period after expiration
  gracePeriodEndsAt DateTime? // When grace period expires (calculated)
  inGracePeriod    Boolean   @default(false) // Whether currently in grace period

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId    String
  plan      Plan   @relation(fields: [planId], references: [id])

  // Payment history
  payments  Payment[]

  @@index([userId])
  @@index([status])
  @@index([planId])
  @@index([renewalId])
  @@index([expiresAt])
  @@index([paystackReference])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  PENDING_PAYMENT
  GRACE_PERIOD
}


model Payment {
  id                String        @id @default(cuid())
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("NGN")

  // Multi-currency tracking
  selectedCurrency  String        @default("NGN")  // Currency user selected (NGN, USD, GBP, EUR)
  exchangeRate      Decimal?      @db.Decimal(10, 6)  // Exchange rate at time of payment
  amountInNGN       Decimal?      @db.Decimal(10, 2)  // Amount in NGN for reporting

  // Payment Type
  paymentType       PaymentType   @default(INITIAL)

  // Paystack References
  paystackReference String        @unique
  paystackAuthorizationUrl String? // For initial payment
  paystackAccessCode String?      // Paystack access code

  // Payment Status
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  failedAt          DateTime?

  // Payment Details
  paymentMethod     String?       // card, bank_transfer, etc.
  customerEmail     String?
  customerName      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId    String
  plan      Plan   @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([paystackReference])
  @@index([status])
  @@index([paymentType])
  @@index([createdAt])
}

enum PaymentType {
  INITIAL   // Initial subscription payment
  RENEWAL   // Renewal to lifetime/forever access
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REFUNDED
}

