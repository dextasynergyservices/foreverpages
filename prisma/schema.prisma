// Job queue for processing uploaded templates reliably across deployments
model TemplateJob {
  id         String                 @id @default(cuid())
  templateId String
  template   Template               @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // The directory on disk where the uploaded/extracted files were saved (if present)
