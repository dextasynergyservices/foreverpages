// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



// ============================================
// CORE USER & AUTHENTICATION
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?   // Hashed password for email/password auth
  image         String?
  bio           String?   @db.Text
  phone         String?

  // Role & Permissions
  role          UserRole  @default(USER)

  // Current Plan
  currentPlanId String?
  currentPlan   Plan?     @relation("UserCurrentPlan", fields: [currentPlanId], references: [id], onDelete: SetNull)

  // Email verification tracking
  verificationMethod VerificationMethod?
  lastVerificationSentAt DateTime?
  verificationAttempts Int @default(0)

  // Security
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  twoFactorMethod  TwoFactorMethod?
  backupCodes      String[] // Hashed backup codes for account recovery

  // Preferences
  notificationsEnabled Boolean @default(true)
  language             String  @default("en")
  timezone             String  @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userTemplates UserTemplate[]
  payments      Payment[]
  accounts         Account[]
  sessions         Session[]
  memorials        Memorial[]
  posts            Post[]
  comments         Comment[]
  reactions        Reaction[]
  uploads          Upload[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  sentInvitations  Invitation[]     @relation("InvitedBy")
  receivedInvites  Invitation[]     @relation("InvitedUser")
  subscriptions    Subscription[]
  verificationTokens VerificationToken[]
  streamViewers  StreamViewer[]
  streamComments StreamComment[]
  streamReactions StreamReaction[]
  // Template versioning: versions created by this user
  createdTemplateVersions TemplateVersion[]

  // Real-time collaboration
  memorialPresence MemorialPresence[]
  editLocks        EditLock[]
  activityLogs     ActivityLog[]

  // Account details for donations/support
  accountDetails   Json?            @db.Json

  // Memorial support relationships
  receivedSupports MemorialSupport[] @relation("ReceivedSupports")
  sentSupports     MemorialSupport[] @relation("SentSupports")

  @@index([email])
  @@index([role])
  @@index([currentPlanId])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum VerificationMethod {
  LINK
  CODE
}

enum TwoFactorMethod {
  EMAIL
  AUTHENTICATOR
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   // Usually email address
  token      String   @unique
  code       String   // 6-digit verification code
  type       VerificationType
  expires    DateTime
  usedAt     DateTime?

  // Add user relationship (optional for backward compatibility)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
  @@index([identifier])
  @@index([code])
  @@index([expires])
  @@index([userId])
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  TWO_FACTOR
  TWO_FACTOR_SESSION
}

// ============================================
// MEMORIAL PAGES
// ============================================

model Memorial {
  id          String   @id @default(cuid())
  slug        String   @unique

  // Deceased Information
  firstName   String
  lastName    String
  middleName  String?
  maidenName  String?
  nicknames   String[] // Array of nicknames
  prefix      String?  // Dr., Rev., etc.
  suffix      String?  // Jr., Sr., III, etc.

  // Life Dates
  birthDate   DateTime
  deathDate   DateTime
  age         Int?     // Calculated or manual

  // Places
  birthPlace  String?
  deathPlace  String?
  hometown    String?
  residence   String?
  nationality String?

  // Biography
  biography   String?  @db.Text
  epitaph     String?  @db.Text
  obituary    String?  @db.Text
  lifeStory   String?  @db.Text
  legacy      String?  @db.Text

  // Images
  profilePhoto String?
  coverPhoto   String?
  galleryPhotos String[] // Array of image URLs

  // Funeral & Memorial Info
  funeralDate      DateTime?
  funeralLocation  String?
  funeralDetails   String?   @db.Text
  burialPlace      String?
  burialDate       DateTime?
  memorialService  String?   @db.Text

  // Charitable Info
  charityName      String?
  charityUrl       String?
  donationInfo     String?   @db.Text

  // Settings
  visibility       MemorialVisibility @default(PUBLIC)
  allowComments    Boolean            @default(true)
  moderateComments Boolean            @default(false)
  allowPhotos      Boolean            @default(true)
  allowStories     Boolean            @default(true)
  allowCandles     Boolean            @default(true)
  allowFlowers     Boolean            @default(true)

  // Localization
  language         String             @default("en") // Language this memorial is written in

  // QR Code & Sharing
  qrCodeUrl        String?
  customDomain     String?            @unique
  password         String?            // For password-protected memorials

  // SEO
  metaTitle        String?
  metaDescription  String?
  keywords         String[]

  // Statistics
  viewCount        Int      @default(0)
  shareCount       Int      @default(0)
  candleCount      Int      @default(0)
  flowerCount      Int      @default(0)

  // Status
  isPublished      Boolean  @default(false)
  isPremium        Boolean  @default(false)
  expiresAt        DateTime?

  // Version control for optimistic locking
  version          Int      @default(1)
  lastEditedBy     String?
  lastEditedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?

  // Relations
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)

 // Use UserTemplate instead of Template
  userTemplateId String?
  userTemplate   UserTemplate? @relation(fields: [userTemplateId], references: [id], onDelete: SetNull)

  invitations Invitation[]
  timeline    TimelineEvent[]
  family      FamilyMember[]
  posts       Post[]
  comments    Comment[]
  reactions   Reaction[]
  uploads     Upload[]
  candles     VirtualCandle[]
  flowers     VirtualFlower[]
  guestbook   GuestbookEntry[]
  tags        MemorialTag[]
  streams     MemorialStream[]  // Livestreams
  drafts      MemorialDraft[]

  // Real-time collaboration
  presence    MemorialPresence[]
  editLocks   EditLock[]
  activityLog ActivityLog[]

  @@index([slug])
  @@index([ownerId])
  @@index([visibility])
  @@index([isPublished])
  @@index([createdAt])
  @@index([userTemplateId])
}

model MemorialDraft {
  id          String   @id @default(cuid())
  memorialId  String
  memorial    Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  // Draft data as JSON
  data        Json

  // Version tracking for multi-version drafts
  version     Int      @default(1)

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([memorialId])
  @@index([createdAt])
}

enum MemorialVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
  PASSWORD_PROTECTED
}

// ============================================
// COLLABORATION & PERMISSIONS
// ============================================

model Invitation {
  id          String           @id @default(cuid())
  email       String?          // Optional email address
  phone       String?          // WhatsApp phone number with country code
  name        String?          // Recipient name
  role        MemorialRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  message     String?          @db.Text
  invitationCard String?       // URL to uploaded invitation card/image
  customSubject  String?       // Custom email subject (overrides default)

  // Delivery channels
  sentViaEmail    Boolean @default(false)
  sentViaWhatsApp Boolean @default(false)

  // RSVP System
  rsvpToken       String?          @unique // Unique token for RSVP page access
  rsvpStatus      RSVPStatus?      // Guest's RSVP response
  rsvpMessage     String?          @db.Text // Personal message from guest when RSVPing
  rsvpAt          DateTime?        // When guest submitted RSVP

  // Guest Management
  plusOnes            Int?     // Number of additional guests
  dietaryRestrictions String?  @db.Text // Food preferences, allergies
  accessibilityNeeds  String?  @db.Text // Wheelchair, interpreter, etc.
  specialRequests     String?  @db.Text // General notes

  // Email Templates
  templateId          String?  // Selected template (formal, casual, religious, custom)
  templateVariables   Json?    // Custom variables for template personalization

  // Scheduling
  scheduledFor        DateTime? // When to send (null = send immediately)
  isScheduled         Boolean   @default(false)
  wasSentScheduled    Boolean   @default(false) // Track if it was sent as scheduled

  // Reminders
  sendReminders       Boolean   @default(true)  // Enable/disable reminders for this invitation
  reminderDaysBefore  Int[]     @default([7, 3, 1]) // Days before service to send reminders
  remindersSent       Json?     // Track which reminders were sent {7: timestamp, 3: timestamp}
  lastReminderSentAt  DateTime? // Last reminder timestamp

  expiresAt   DateTime
  sentAt      DateTime         @default(now())
  acceptedAt  DateTime?
  declinedAt  DateTime?

  memorialId  String
  memorial    Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  invitedUserId String?
  invitedUser   User?   @relation("InvitedUser", fields: [invitedUserId], references: [id])

  @@index([memorialId])
  @@index([email])
  @@index([phone])
  @@index([token])
  @@index([rsvpToken])
  @@index([rsvpStatus])
  @@index([status])
  @@index([scheduledFor])
  @@index([isScheduled])
  @@index([sendReminders])
}

enum MemorialRole {
  OWNER
  ADMIN
  EDITOR
  CONTRIBUTOR
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum RSVPStatus {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}

// ============================================
// REAL-TIME COLLABORATION
// ============================================

model MemorialPresence {
  id          String       @id @default(cuid())
  memorialId  String
  memorial    Memorial     @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  userName    String       // Cache user name for faster display
  userRole    MemorialRole // Cache user role

  section     String?      // Which section they're viewing (biography, gallery, etc)
  isEditing   Boolean      @default(false) // Are they actively editing?

  lastSeen    DateTime     @default(now())

  @@unique([memorialId, userId])
  @@index([memorialId])
  @@index([lastSeen])
}

model EditLock {
  id          String   @id @default(cuid())
  memorialId  String
  memorial    Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  section     String   // Which section is locked (biography, gallery, tributes, etc)

  lockedById  String
  lockedBy    User     @relation(fields: [lockedById], references: [id], onDelete: Cascade)

  userName    String   // Cache user name for display
  userRole    MemorialRole // Cache user role

  lockedAt    DateTime @default(now())
  expiresAt   DateTime // Auto-release after timeout (default 5 minutes)

  @@unique([memorialId, section])
  @@index([memorialId])
  @@index([expiresAt])
}

// ============================================
// TIMELINE & LIFE EVENTS
// ============================================

model TimelineEvent {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  date        DateTime
  endDate     DateTime?     // For events with duration
  eventType   TimelineEventType
  location    String?
  images      String[]

  isHighlight Boolean       @default(false)
  order       Int?          // Custom ordering

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  memorialId  String
  memorial    Memorial      @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([date])
  @@index([eventType])
}

enum TimelineEventType {
  BIRTH
  EDUCATION
  GRADUATION
  CAREER
  MARRIAGE
  ENGAGEMENT
  CHILDREN
  GRANDCHILDREN
  MILITARY
  AWARD
  ACHIEVEMENT
  TRAVEL
  HOBBY
  VOLUNTEER
  PUBLICATION
  RETIREMENT
  ILLNESS
  DEATH
  FUNERAL
  MEMORIAL
  OTHER
}

// ============================================
// FAMILY TREE
// ============================================

model FamilyMember {
  id           String              @id @default(cuid())
  firstName    String
  lastName     String
  relationship FamilyRelationship
  isDeceased   Boolean             @default(false)
  birthYear    Int?
  deathYear    Int?
  photo        String?
  bio          String?             @db.Text

  memorialId   String
  memorial     Memorial            @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([relationship])
}

enum FamilyRelationship {
  SPOUSE
  PARTNER
  FATHER
  MOTHER
  SON
  DAUGHTER
  BROTHER
  SISTER
  GRANDFATHER
  GRANDMOTHER
  GRANDSON
  GRANDDAUGHTER
  UNCLE
  AUNT
  NEPHEW
  NIECE
  COUSIN
  OTHER
}

// ============================================
// CONTENT & POSTS
// ============================================

model Post {
  id          String     @id @default(cuid())
  title       String?
  content     String     @db.Text
  type        PostType

  // Media
  images      String[]
  videos      String[]
  attachments String[]

  // Moderation
  isApproved  Boolean    @default(true)
  isPinned    Boolean    @default(false)

  // Author Info (for non-users)
  authorName  String?
  authorEmail String?

  // Localization
  language    String     @default("en") // Language this post is written in

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  memorialId  String
  memorial    Memorial   @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  comments    Comment[]
  reactions   Reaction[]

  @@index([memorialId])
  @@index([type])
  @@index([isApproved])
  @@index([createdAt])
}

enum PostType {
  TRIBUTE
  MEMORY
  STORY
  CONDOLENCE
  PHOTO
  VIDEO
  ANNOUNCEMENT
}

enum CommentType {
  GENERAL
  CONDOLENCE
  MEMORY
  TRIBUTE
  APPRECIATION
}

model Comment {
  id          String      @id @default(cuid())
  content     String      @db.Text
  type        CommentType @default(GENERAL) // Type of comment/message

  // Author Info (for non-users)
  authorName  String?
  authorEmail String?

  // Localization
  language    String   @default("en") // Language this comment is written in

  isApproved  Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  postId      String?
  post        Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  memorialId  String
  memorial    Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  parentId    String?
  parent      Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([memorialId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@index([type])
}

model Reaction {
  id         String       @id @default(cuid())
  type       ReactionType

  createdAt  DateTime     @default(now())

  postId     String?
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)

  memorialId String
  memorial   Memorial     @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
  @@index([memorialId])
  @@index([userId])
}

enum ReactionType {
  HEART
  PRAYER
  HUG
  ROSE
  CANDLE
  DOVE
  ANGEL
}

// ============================================
// MEDIA & UPLOADS
// ============================================

model Upload {
  id           String     @id @default(cuid())
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  url          String
  thumbnailUrl String?

  type         UploadType

  // Metadata
  width        Int?
  height       Int?
  duration     Int?       // seconds for video/audio

  title        String?
  description  String?    @db.Text
  caption      String?

  // Organization
  album        String?
  tags         String[]
  dateTaken    DateTime?
  sortOrder    Int?       // Custom sort order for user's gallery

  isPublic     Boolean    @default(true)

  createdAt    DateTime   @default(now())

  // Cloudinary public ID for deletion
  publicId     String?

  // Optional: Can be uploaded to library first, attached to memorial later
  memorialId   String?
  memorial     Memorial?  @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  uploaderId   String
  uploader     User       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([type])
  @@index([album])
  @@index([uploaderId])
  @@index([uploaderId, sortOrder])
}

enum UploadType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// ============================================
// VIRTUAL TRIBUTES
// ============================================

model VirtualCandle {
  id          String   @id @default(cuid())
  message     String?  @db.Text
  senderName  String
  senderEmail String?

  litAt       DateTime @default(now())
  expiresAt   DateTime // Candles expire after X days

  memorialId  String
  memorial    Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([litAt])
}

model VirtualFlower {
  id          String     @id @default(cuid())
  flowerType  FlowerType
  message     String?    @db.Text
  senderName  String
  senderEmail String?

  sentAt      DateTime   @default(now())

  memorialId  String
  memorial    Memorial   @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([sentAt])
}

enum FlowerType {
  ROSE
  LILY
  CARNATION
  ORCHID
  TULIP
  SUNFLOWER
  MIXED_BOUQUET
}

model GuestbookEntry {
  id          String   @id @default(cuid())
  name        String
  email       String?
  location    String?
  message     String   @db.Text
  relationship String?

  isApproved  Boolean  @default(true)
  isPublic    Boolean  @default(true)

  createdAt   DateTime @default(now())

  memorialId  String
  memorial    Memorial @relation(fields: [memorialId], references: [id], onDelete: Cascade)

  @@index([memorialId])
  @@index([createdAt])
}

// ============================================
// SUBSCRIPTIONS & BILLING
// ============================================

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique // Default/fallback name
  slug        String   @unique
  description String?  @db.Text // Default/fallback description

  // Pricing & Duration - Multi-currency support
  priceNGN    Decimal?  @db.Decimal(10, 2)  // Nigerian Naira (primary)
  priceUSD    Decimal?  @db.Decimal(10, 2)  // US Dollar
  priceGBP    Decimal?  @db.Decimal(10, 2)  // British Pound
  priceEUR    Decimal?  @db.Decimal(10, 2)  // Euro
  currency    String    @default("NGN")      // Default currency indicator
  durationDays Int      // Number of days the plan is valid for

  // Plan Features & Limits
  maxMemorials         Int      @default(1)
  maxPhotosPerMemorial Int      @default(50)
  maxVideosPerMemorial Int      @default(5)
  maxAdmins            Int      @default(1)
  maxContributors      Int      @default(3)
  storageQuotaMB       Int      @default(500)
  prints               String

  // Feature Flags
  allowRSVP            Boolean  @default(true)  // Can manage RSVP for funeral/memorial services
  allowGuestbook       Boolean  @default(true)  // Can enable digital guestbook
  allowVirtualTributes Boolean  @default(true)  // Can receive virtual candles & flowers

  // Display & Marketing
  isPopular       Boolean  @default(false)
  isVisible       Boolean  @default(true)
  displayOrder    Int      @default(0)
  badgeText       String?  // "Most Popular", "Best Value"
  badgeColor      String?  // For badge styling

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions    Subscription[]
  templates        Template[]
  payments         Payment[]
  users            User[]              @relation("UserCurrentPlan")
  translations     PlanTranslation[]

  @@index([slug])
  @@index([isVisible])
  @@index([displayOrder])
  @@index([durationDays])
}

model PlanTranslation {
  id          String   @id @default(cuid())
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  language    String   // ISO 639-1: "en", "fr", "es", "ig", "yo", "ha"

  // Translated fields
  name        String
  description String   @db.Text
  badgeText   String?

  // Features as JSON for flexibility
  // {"photos": "Up to 50 photos", "videos": "5 videos", ...}
  features    Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([planId, language])
  @@index([planId])
  @@index([language])
}

model Translation {
  id        String   @id @default(cuid())
  key       String   // e.g., "pricing.title", "common.cancel"
  value     String   @db.Text
  language  String   // "en", "fr", "es", etc.

  // Organization
  namespace String   @default("common") // "pricing", "auth", "memorial", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, language, namespace])
  @@index([namespace, language])
  @@index([key])
  @@index([language])
}

model Renewal {
  id          String   @id @default(cuid())
  name        String   @unique // "Forever Access"
  slug        String   @unique // "forever-access"
  description String?  @db.Text // Default/fallback description

  // Pricing - Multi-currency support
  priceNGN    Decimal?  @db.Decimal(10, 2)  // Nigerian Naira (primary)
  priceUSD    Decimal?  @db.Decimal(10, 2)  // US Dollar
  priceGBP    Decimal?  @db.Decimal(10, 2)  // British Pound
  priceEUR    Decimal?  @db.Decimal(10, 2)  // Euro
  currency    String    @default("NGN")      // Default currency indicator

  // Display & Marketing
  isActive    Boolean  @default(true)
  badgeText   String?  // "Lifetime", "Forever"
  badgeColor  String?  // For badge styling

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions    Subscription[]
  translations     RenewalTranslation[]

  @@index([slug])
  @@index([isActive])
}

model RenewalTranslation {
  id          String   @id @default(cuid())
  renewalId   String
  renewal     Renewal  @relation(fields: [renewalId], references: [id], onDelete: Cascade)

  language    String   // ISO 639-1: "en", "fr", "es", "ig", "yo", "ha"

  // Translated fields
  name        String
  description String   @db.Text
  badgeText   String?

  // Features as JSON for flexibility
  // {"benefit": "Never lose your memories", "access": "Unlimited forever", ...}
  features    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([renewalId, language])
  @@index([renewalId])
  @@index([language])
}

// ============================================
// DYNAMIC TEMPLATE SYSTEM (Next.js/React/Tailwind)
// ============================================

model TemplateCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  color       String?
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)

  templateCategories TemplateCategoryRelation[]
  templates            Template[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
}

model TemplateCategoryRelation {
  id         String   @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  categoryId String
  category   TemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([templateId, categoryId])
  @@index([templateId])
  @@index([categoryId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  version     String   @default("1.0.0")

  // Template Assets
  previewImage   String
  thumbnailImage String
  categoryId   String?

  // React Component Configuration
  componentPath  String  // Path to main React component (e.g., "templates/classic/MemorialTemplate")
  propsSchema    Json?   // JSON schema for template configuration/validation

  // Template Features
  supportedSections TemplateSectionType[]
  layoutType     TemplateLayout @default(FLEXIBLE)

  // Preview mode override: AUTO (use manifest), IFRAME (embed), STATIC (serve built html)
  previewMode     PreviewMode? @default(AUTO)

  // Design System Configuration
  designTokens   Json?   // Tailwind classes, colors, typography, etc.
  defaultConfig  Json?   // Default settings for new memorials

  // Navigation & Header Configuration
  navigationConfig Json? // Custom nav structure per template
  headerConfig     Json? // Header styling and content

  // Status & Organization
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  displayOrder   Int      @default(0)

  // Processing & Storage
  processingStatus TemplateProcessingStatus @default(PROCESSING)
  storagePath      String?
  // Stored manifest.json uploaded with the template (validated)
  manifest         Json?
  buildCachePath   String?  // Legacy - optional
  typesPath        String?
  processingLogs   String? @db.Text
  packageUrl       String?  // Legacy - optional
  // Map of relative asset paths => uploaded public URLs (e.g., index.html, assets/*)
  artifactAssets   Json?    // Legacy - optional
  processingLogsUrl String? // Legacy - optional
  // GitHub PR metadata (Phase 3)
  prNumber String?
  prUrl    String?

  // Next.js Template Support (Phase 2)
  isNextJsTemplate Boolean @default(false)  // Flag for template type
  configPath       String?                   // Path to config.ts (e.g., "templates/light-template/config")

  // Usage Statistics
  usageCount     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  templateCategories TemplateCategoryRelation[]
  category     TemplateCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userTemplates UserTemplate[]
  sections      TemplateSection[]
  plans         Plan[]
  // Historical versions for this template
  templateVersions TemplateVersion[]
  // Back-relation for processing jobs
  templateJobs    TemplateJob[]

  @@index([slug])
  @@index([isActive])
  @@index([isFeatured])
  @@index([displayOrder])
}

// Stores historical snapshots of templates when they are replaced/updated
model TemplateVersion {
  id             String   @id @default(cuid())
  templateId     String
  template       Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Snapshot fields
  name           String
  slug           String
  description    String?  @db.Text
  version        String
  previewImage   String?
  thumbnailImage String?
  componentPath  String?
  designTokens   Json?
  defaultConfig  Json?
  manifest       Json?
  packageUrl     String?
  artifactAssets  Json?
  storagePath    String?

  // Who created this version (admin user id)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([templateId])
  @@index([createdAt])
}

model TemplateSection {
  id          String              @id @default(cuid())
  type        TemplateSectionType
  name        String
  description String?             @db.Text

  // Component Configuration
  componentPath  String?          // Path to section component (optional - falls back to default)
  propsSchema    Json?            // JSON schema for section configuration

  // Section Configuration
  layout      TemplateSectionLayout @default(DEFAULT)
  contentConfig Json?              // Supported content types and limits
  styleConfig   Json?              // Default styling options

  // Behavior
  isCollapsible    Boolean @default(false)
  isHideable       Boolean @default(true)
  defaultVisible   Boolean @default(true)

  // Order & Requirements
  order            Int
  required         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  templateId      String
  template        Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, type])
  @@index([templateId])
  @@index([type])
  @@index([order])
}

// Memorial support/donations tracking
model MemorialSupport {
