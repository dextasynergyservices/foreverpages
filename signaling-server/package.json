{
  "name": "foreverpages-signaling",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "signaling:dev": "tsx signaling-server/src/index.ts",
    "signaling:build": "tsc -p signaling-server/tsconfig.json",
    "signaling:start": "node signaling-server/dist/index.js",
    "signaling:docker-build": "docker build -t foreverpages-signaling ./signaling-server",
    "signaling:docker-run": "docker run -p 3001:3000 -e PORT=3000 foreverpages-signaling"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "redis": "4.7.1",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^20.9.0",
    "tsx": "^3.12.7",
    "typescript": "^5.4.2"
  }
}
