# Brevo (SendinBlue) Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@foreverpages.online
BREVO_SENDER_NAME=ForeverPages
BREVO_ADMIN_EMAIL=admin@foreverpages.online

# Green API (WhatsApp Service - Free tier: 1,000 messages/month)
# Sign up at: https://green-api.com/
# Steps: 1) Create account 2) Create instance 3) Scan QR code with WhatsApp 4) Copy Instance ID and Token
GREEN_API_INSTANCE_ID=your_instance_id_here
GREEN_API_TOKEN=your_api_token_here

# Exchange Rate API (Free tier: 1,500 requests/month)
# Sign up at: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# Paystack Configuration
# Get your keys from: https://dashboard.paystack.com/#/settings/developers
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Cloudinary Configuration (Media Upload & Storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET_IMAGE=foreverpages_images
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET_VIDEO=foreverpages_videos

CRON_SECRET="your-random-secure-string"
ADMIN_EMAIL="admin@foreverpages.online"

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Signaling Server Configuration
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Public - Base URL for emails and links
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000